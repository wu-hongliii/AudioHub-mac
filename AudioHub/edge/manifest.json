{
  "manifest_version": 3,
  "name": "AudioHub 网页音源",
  "version": "0.1.0",
  "description": "将 Edge 网页音源接入本机 AudioHub 中控台",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "连接 AudioHub 中控台"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}